{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "wrench-execucao-api"
  },
  "JwtOptions": {
    "Issuer": "Wrench Auto Repair",
    "Audience": "Wrench Auto Repair"
  },
  "Dynamo": {
    "Execucao": "wrench-execucao",
    "Outbox": "wrench-execucao-outbox",
    "Idempotencia": "wrench-execucao-idempotencia",
    "CriarTabelas": false
  },
  "Sns": {
    "TopicArn": ""
  },
  "Outbox": {
    "IntervaloSegundos": 2,
    "TamanhoLote": 25
  },
  "Execucao": {
    "PermitirFalhaForcada": false
  }
}
